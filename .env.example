# Скопируйте в .env и заполните. Файл .env в git не попадает.

# PostgreSQL. Локально: docker compose up -d db
# На Vercel строку подключения добавляет интеграция Neon (Storage → Neon).
DATABASE_URL=postgres://kleo:kleo@localhost:5432/kleo

# Секрет Payload: длинная случайная строка (например, openssl rand -hex 32)
PAYLOAD_SECRET=

# Адрес сайта без слеша на конце (canonical, hreflang, письма)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob для фото. Пусто — файлы сохраняются в папку /media
BLOB_READ_WRITE_TOKEN=

# Заявки с сайта: кому отправлять письма
LEADS_EMAIL_TO=
# SMTP для отправки писем. Пусто — письма только пишутся в лог сервера
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kleo Homes <no-reply@kleohomes.com>
