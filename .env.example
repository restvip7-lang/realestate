# Скопируйте в .env и заполните. Файл .env в git не попадает.

# PostgreSQL. Локально: docker compose up -d db
# На Vercel строку подключения добавляет интеграция Neon (Storage → Neon).
DATABASE_URL=postgres://kleo:kleo@localhost:5432/kleo

# Секрет Payload: длинная случайная строка (например, openssl rand -hex 32)
PAYLOAD_SECRET=

# Адрес сайта без слеша на конце (canonical, hreflang, письма)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob для фото. Пусто — файлы сохраняются в папку /media
BLOB_READ_WRITE_TOKEN=

# Заявки с сайта: кому отправлять письма
LEADS_EMAIL_TO=
# SMTP для отправки писем. Пусто — письма только пишутся в лог сервера
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kleo Homes <no-reply@kleohomes.com>

# Объекты из Stay Portfolio Service (docs/stay-import.md). Ключи выдаёт администратор Stay (пользователь с ролью API User).
STAY_TOKEN=
STAY_USERNAME=
STAY_PASSWORD=
# STAY_API_URL=https://portfolio.stayrepo.com/ws
# Тестовый режим: только столько самых свежих объектов. Пусто — все объекты Аланьи и Газипаши.
STAY_SYNC_LIMIT=50
# Ежедневный запуск синхронизации на Vercel (vercel.json). Любая длинная случайная строка.
CRON_SECRET=
# Автоперевод объявлений на турецкий (Claude API). Пусто — в турецкой версии английский текст.
ANTHROPIC_API_KEY=
# Модель перевода. По умолчанию claude-opus-5-5; дешевле — claude-haiku-4-5.
# STAY_TRANSLATE_MODEL=claude-haiku-4-5

# Новости, отзывы и услуги из Stay Property (docs/content-import.md). Ключи не нужны: сервис отдаёт контент без авторизации.
# CONTENT_API_URL=https://admin.stayproperty.com
# Если в сервисе включат токен для API (MIRROR_API_TOKEN), впишите его сюда.
# CONTENT_API_TOKEN=
